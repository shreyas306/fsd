  "letters": [
    {
      "id": "let_01",
      "capsule_id": "cap_unlocked_01",
      "author_id": "usr_demo_02",
      "author_name": "Alex Vance",
      "title": "To the travelers we are becoming",
      "content": "Dear Future Self,\n\nIf you are reading this, time has slipped past like sand through cupped hands. \nRemember the salt spray in Monterey? Remember how we promised we wouldn't settle into comfortable numbness?\n\nRight now, as I write this, you were terrified of taking risks, yet you packed two bags and drove into the unknown. I hope you still look up at the stars with that exact reverence. I hope you haven't forgotten how laughter sounds when your ribs ache.\n\nKeep building. Keep trusting. Keep wandering.\n\nWith unconditional love,\nYour 2024 Self",
      "prompt_used": "What do you hope your future self remembers?",
      "created_at": "2026-09-27T09:44:30.539Z",
      "updated_at": "2026-09-27T09:44:30.539Z"
    },
    {
      "id": "let_02",
      "capsule_id": "cap_sealed_soon_02",
      "author_id": "usr_demo_02",
      "author_name": "Alex Vance",
      "title": "Unlocking the 30s: No Regrets",
      "content": "Hello Alex!\nToday you turn a new chapter. We worried so much about having everything figured out. Did we solve the puzzle? Probably not, and that is okay. Celebrate this day with people who genuinely care about your peace of mind.",
      "prompt_used": "What are your biggest dreams?",
      "created_at": "2026-11-01T09:44:30.539Z",
      "updated_at": "2026-11-01T09:44:30.539Z"
    }
  ],
